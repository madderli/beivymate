        <mxCell id="BLnZBBrP-C4UVX5Zc65d-1" value="&lt;div style=&quot;line-height: 130%;&quot;&gt;&lt;font style=&quot;font-size: 9px; line-height: 130%;&quot;&gt;1. gateway.py：统一的LLM调用入口，统一调用Provider。&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 9px; line-height: 130%;&quot;&gt;2. strategy.py：定义模型使用策略&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;font style=&quot;font-size: 9px; line-height: 130%;&quot;&gt;3. models.py：定义LLMRequest、LLMResponse、ChatMessage等数据结构&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;font style=&quot;font-size: 9px; line-height: 130%;&quot;&gt;4. provider.py：定义 LLMProvider Protocol 抽象接口&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;font style=&quot;font-size: 9px; line-height: 130%;&quot;&gt;5. provider/ollama.py：Ollama平台适配器，Ollama API 协议适配。&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;font style=&quot;font-size: 9px; line-height: 130%;&quot;&gt;6. transport.py：处理 HTTP通信（proxy，timeout， headers）&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=#d5e8d4;strokeColor=#82b366;" parent="9-oLpZpqAt2Iia4TmWr9-2" vertex="1">
