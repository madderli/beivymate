        </mxCell>
        <mxCell id="KTNjFAKgC9qWqsBmtt3N-11" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;原则1：用户资源和代码分离&lt;/font&gt;&lt;/h1&gt;&lt;p&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); text-align: center; background-color: transparent;&quot;&gt;resource/ ：用户可维护&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); text-align: center; background-color: transparent;&quot;&gt;src/：系统代码&lt;/span&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fillColor=#f9f7ed;strokeColor=#36393d;" vertex="1" parent="KTNjFAKgC9qWqsBmtt3N-7">
          <mxGeometry x="40" y="40" width="360" height="120" as="geometry" />
        </mxCell>
        <mxCell id="KTNjFAKgC9qWqsBmtt3N-12" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;原则2：用户医院按用途分成三个系统&lt;/font&gt;&lt;/h1&gt;&lt;p&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); text-align: center; background-color: transparent;&quot;&gt;Configuration：控制 Agent 怎么工作&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); text-align: center; background-color: transparent;&quot;&gt;Template：定义 Agent 产出什么&lt;/span&gt;&lt;/p&gt;&lt;p&gt;Knowledge：提供 Agent 知道什么&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fillColor=#f9f7ed;strokeColor=#36393d;" vertex="1" parent="KTNjFAKgC9qWqsBmtt3N-7">
