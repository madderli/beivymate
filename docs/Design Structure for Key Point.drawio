        <mxCell id="KTNjFAKgC9qWqsBmtt3N-6" value="ConfigurationService：加载 / 修改 / 验证配置&lt;div&gt;TemplateService：加载 / 选择 / 渲染模板&lt;/div&gt;&lt;div&gt;KnowledgeService：倒入 / 索引 / 检索知识&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="zTGoPc9mnJfGg8IjxUwy-5">
